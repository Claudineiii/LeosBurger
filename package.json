{
  "name": "leosburger",
  "version": "1.0.0",
  "description": "Plataforma de pedidos online para lanchonete, com cardápio digital integrado.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "tsx scripts/test-database.ts vitest",
    "test:watch": "tsx scripts/test-database.ts vitest",
    "db:test:migrate": "tsx scripts/test-database.ts migrate",
    "postinstall": "prisma skills sync || exit 0",
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/server.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Claudineiii/LeosBurger.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Claudineiii/LeosBurger/issues"
  },
  "homepage": "https://github.com/Claudineiii/LeosBurger#readme",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.3",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.5",
    "@fastify/swagger": "^9.9.2",
    "@fastify/type-provider-zod": "^1.0.1",
    "@prisma/client": "^6.19.3",
    "@scalar/fastify-api-reference": "^1.74.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.1",
    "zod": "^4.6.7"
  }
}
